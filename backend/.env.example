# ── Anthropic (required) ─────────────────────────────────────────
# Powers all AI features: ICP generation, persona creation, conversation replies
ANTHROPIC_API_KEY=sk-ant-...

# ── Unipile (Phase 4+) ────────────────────────────────────────────
# LinkedIn account management, messaging, inbox sync, scraping
UNIPILE_API_KEY=
UNIPILE_DSN=

# ── Apollo.io (Phase 3+) ──────────────────────────────────────────
# Lead database (300M+ contacts) and enrichment
APOLLO_API_KEY=

# ── Trigify (Phase 2+) ────────────────────────────────────────────
# Real-time LinkedIn intent signal monitoring for Signal Agents
TRIGIFY_API_KEY=

# ── Redis (required) ──────────────────────────────────────────────
# Backs the BullMQ queue that drives all campaign/sequence sending
# (connection requests, messages, wait/reply resumption) and the
# per-LinkedIn-account send lock. Campaign sending will not work
# without this — run Redis locally with e.g.
# `docker run -d -p 6379:6379 redis` or `brew install redis`.
REDIS_URL=redis://localhost:6379
# Worker concurrency (distinct campaigns processed in parallel — a
# per-account lock still serializes sends within one LinkedIn account
# regardless of this value). Defaults to 10 if unset.
QUEUE_CONCURRENCY=10

# ── Supabase (Phase 1+) ───────────────────────────────────────────
# Backend-only — service_role bypasses RLS, never expose this to the
# frontend. Anon key is not used by the backend (it always acts as
# service_role).
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ── Server ────────────────────────────────────────────────────────
PORT=3001
NODE_ENV=development

# Public URL this backend is reachable at (used nowhere yet, reserved for
# webhook callback URLs).
BACKEND_URL=http://localhost:3001
# Deployed frontend origin — added to the CORS allowlist and used to build
# invite-email links (routes/members.js).
FRONTEND_URL=http://localhost:5173
