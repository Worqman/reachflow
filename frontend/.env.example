# ── Supabase (required) ────────────────────────────────────────────
VITE_SUPABASE_URL=
# anon/public key ONLY — never the service_role key. Get this from
# Supabase Dashboard → Settings → API → "anon public".
VITE_SUPABASE_ANON_KEY=

# ── Backend API (optional) ──────────────────────────────────────────
# Leave unset for local dev against the Vite proxy, or set to the deployed
# backend's URL. On Vercel, set this as a project Environment Variable
# (dashboard → Settings → Environment Variables), not in a committed file.
# VITE_API_URL=http://localhost:3001
